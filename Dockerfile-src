FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /build

COPY pyproject.toml uv.lock README.md LICENSE NOTICE /build/
COPY schemachange /build/schemachange

RUN uv build --wheel


FROM python:3.12-slim

COPY --from=builder /build/dist/schemachange-*-py3-none-any.whl /tmp/
RUN pip install --no-cache-dir /tmp/schemachange-*.whl && rm /tmp/schemachange-*.whl

ENTRYPOINT ["schemachange"]
